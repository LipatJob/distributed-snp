    "        print(f\"  CUDA Memory:  {row['cuda_memory']/total*100:5.1f}%\")\n",
    "        if row['mpi'] > 0:\n",
    "            print(f\"  MPI:          {row['mpi']/total*100:5.1f}%\")"
